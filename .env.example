# Respan gateway credentials for the host-side tools in tools/.
# Copy to .env (git-ignored) and fill in the key; never commit a real key.
# The key is a server secret: only tools/ra_digest.mjs reads it.
RESPAN_API_KEY=

# Optional overrides.
# RESPAN_BASE_URL=https://endpoint.respan.ai/api   # Respan Enterprise
# RESPAN_MODEL=gpt-5.5
